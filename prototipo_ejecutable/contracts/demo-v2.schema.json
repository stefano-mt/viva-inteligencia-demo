{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viva.com.pe/schemas/inteligencia-comercial/demo-v2.schema.json",
  "title": "Viva Inteligencia Comercial - contrato público de demo v2",
  "description": "Contrato autoritativo y proyección legacy temporal para el dataset estático de la demo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "model",
    "pilot",
    "projects",
    "executive",
    "rankings",
    "sourceScope",
    "scopeSummary",
    "matching",
    "coverage",
    "quality",
    "assistant",
    "pipeline",
    "deployment"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "pilot": {
      "$ref": "#/$defs/pilot"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legacyProject"
      }
    },
    "executive": {
      "$ref": "#/$defs/legacyObject"
    },
    "rankings": {
      "$ref": "#/$defs/legacyObject"
    },
    "sourceScope": {
      "$ref": "#/$defs/legacyObjectArray"
    },
    "scopeSummary": {
      "$ref": "#/$defs/legacyObject"
    },
    "matching": {
      "$ref": "#/$defs/legacyObject"
    },
    "coverage": {
      "$ref": "#/$defs/legacyObject"
    },
    "quality": {
      "$ref": "#/$defs/legacyObject"
    },
    "assistant": {
      "$ref": "#/$defs/legacyObject"
    },
    "pipeline": {
      "$ref": "#/$defs/legacyObjectArray"
    },
    "deployment": {
      "$ref": "#/$defs/legacyObject"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableDateTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/dateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "qualityStatus": {
      "enum": [
        "certified",
        "reviewable",
        "inconsistent",
        "illegible",
        "insufficient"
      ]
    },
    "valueKind": {
      "enum": [
        "observed",
        "derived",
        "simulated"
      ]
    },
    "areaType": {
      "enum": [
        "built",
        "free",
        "total",
        "unknown"
      ]
    },
    "priceType": {
      "enum": [
        "list",
        "from",
        "sale",
        "estimated",
        "scenario"
      ]
    },
    "currency": {
      "enum": [
        "PEN",
        "USD",
        "unknown"
      ]
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "dataset_id",
        "generated_at",
        "cutoff_at",
        "input_fingerprints",
        "publication",
        "title",
        "description",
        "source_snapshot",
        "counts"
      ],
      "properties": {
        "contract_version": {
          "const": "2.0.0"
        },
        "dataset_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "generated_at": {
          "$ref": "#/$defs/dateTime"
        },
        "cutoff_at": {
          "$ref": "#/$defs/dateTime"
        },
        "input_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inputFingerprint"
          }
        },
        "publication": {
          "$ref": "#/$defs/publicationPolicy"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_captured_at",
            "max_captured_at",
            "assistant_dataset_run_id"
          ],
          "properties": {
            "min_captured_at": {
              "$ref": "#/$defs/nullableDateTime"
            },
            "max_captured_at": {
              "$ref": "#/$defs/nullableDateTime"
            },
            "assistant_dataset_run_id": {
              "$ref": "#/$defs/nullableNonEmptyString"
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "required": [
            "projects",
            "agencies_in_market",
            "districts"
          ],
          "properties": {
            "projects": {
              "type": "integer",
              "minimum": 0
            },
            "agencies_in_market": {
              "type": "integer",
              "minimum": 0
            },
            "districts": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "inputFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "path",
        "sha256"
      ],
      "properties": {
        "input_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!(?:[^/]+/)*outputs(?:/|$))[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "publicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_public_artifact",
        "contains_contact_pii",
        "raw_payloads_included",
        "restricted_assets_included",
        "policy_version"
      ],
      "properties": {
        "is_public_artifact": {
          "const": true
        },
        "contains_contact_pii": {
          "const": false
        },
        "raw_payloads_included": {
          "const": false
        },
        "restricted_assets_included": {
          "const": false
        },
        "policy_version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "agencies",
        "agencyAliases",
        "projects",
        "typologies",
        "observations",
        "facts",
        "documents",
        "evidence",
        "issues",
        "events"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "agencies": {
          "type": "array",
          "minItems": 30,
          "items": {
            "$ref": "#/$defs/agency"
          }
        },
        "agencyAliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/agencyAlias"
          }
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/project"
          }
        },
        "typologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/typology"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "type",
        "base_url",
        "legal_status",
        "access_mode"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "enum": [
            "portal",
            "agency_website",
            "document",
            "user_provided",
            "controlled_fixture",
            "internal_authorized",
            "other"
          ]
        },
        "base_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "legal_status": {
          "enum": [
            "cleared_for_demo",
            "pending_review",
            "restricted"
          ]
        },
        "access_mode": {
          "enum": [
            "versioned_snapshot",
            "user_provided",
            "public_reference",
            "controlled_fixture"
          ]
        }
      }
    },
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agency_id",
        "canonical_name",
        "normalized_name",
        "domain",
        "pilot_selected",
        "coverage_tier",
        "source_names",
        "selection_reason"
      ],
      "properties": {
        "agency_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "canonical_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "normalized_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[ _-][a-z0-9]+)*$"
        },
        "domain": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "pilot_selected": {
          "type": "boolean"
        },
        "coverage_tier": {
          "oneOf": [
            {
              "enum": [
                "base",
                "enriched",
                "deep"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "source_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "selection_reason": {
          "$ref": "#/$defs/nullableNonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pilot_selected": {
                "const": true
              }
            },
            "required": [
              "pilot_selected"
            ]
          },
          "then": {
            "properties": {
              "coverage_tier": {
                "enum": [
                  "base",
                  "enriched",
                  "deep"
                ]
              },
              "selection_reason": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          },
          "else": {
            "properties": {
              "coverage_tier": {
                "type": "null"
              },
              "selection_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "agencyAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias_original",
        "alias_normalized",
        "agency_id",
        "resolution",
        "evidence_ids"
      ],
      "properties": {
        "alias_original": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "alias_normalized": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "agency_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/namespacedId"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "enum": [
            "confirmed",
            "rule_based",
            "manual_review"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namespacedId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "enum": [
                  "confirmed",
                  "rule_based"
                ]
              }
            },
            "required": [
              "resolution"
            ]
          },
          "then": {
            "properties": {
              "agency_id": {
                "$ref": "#/$defs/namespacedId"
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "agency_id",
        "canonical_name",
        "source_names",
        "location",
        "status",
        "first_seen_at",
        "last_seen_at",
        "quality_status"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "agency_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "canonical_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "status": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "first_seen_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "last_seen_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "quality_status": {
          "$ref": "#/$defs/qualityStatus"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "district",
        "province",
        "department",
        "address",
        "latitude",
        "longitude"
      ],
      "properties": {
        "district": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "province": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "department": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "address": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "typology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typology_id",
        "project_id",
        "model",
        "floor_label_original",
        "floor_min",
        "floor_max",
        "bedrooms_min",
        "bedrooms_max",
        "bathrooms_min",
        "bathrooms_max",
        "quality_status"
      ],
      "properties": {
        "typology_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "project_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "floor_label_original": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "floor_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "floor_max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bedrooms_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bedrooms_max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bathrooms_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "bathrooms_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "quality_status": {
          "$ref": "#/$defs/qualityStatus"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "source_id",
        "entity_type",
        "entity_id",
        "captured_at",
        "source_url",
        "extraction_method",
        "evidence_ids",
        "evidence_status",
        "evidence_absence_reason"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "source_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "entity_type": {
          "enum": [
            "agency",
            "project",
            "typology",
            "document"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "captured_at": {
          "$ref": "#/$defs/dateTime"
        },
        "source_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namespacedId"
          }
        },
        "evidence_status": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        },
        "evidence_absence_reason": {
          "$ref": "#/$defs/nullableNonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "available"
              }
            },
            "required": [
              "evidence_status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "evidence_absence_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              },
              "evidence_absence_reason": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "observation_id",
        "entity_id",
        "field_name",
        "original_value",
        "normalized_value",
        "unit",
        "value_kind",
        "semantic_type",
        "area_type",
        "price_type",
        "currency",
        "denominator_area_type",
        "confidence",
        "quality_status",
        "benchmark_eligible",
        "exclusion_reason",
        "derivation"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "observation_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "entity_id": {
          "$ref": "#/$defs/namespacedId"
        },
        "field_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "original_value": {
          "$ref": "#/$defs/jsonValue"
        },
        "normalized_value": {
          "$ref": "#/$defs/jsonValue"
        },
        "unit": {
          "enum": [
            "m2",
            "PEN",
            "USD",
            "unknown",
            "PEN/m2",
            "USD/m2",
            "unknown/m2",
            "count",
            "percent",
            "date",
            "text",
            "boolean"
          ]
        },
        "value_kind": {
          "$ref": "#/$defs/valueKind"
        },
        "semantic_type": {
          "enum": [
            "area",
            "price",
            "price_per_m2",
            "attribute",
            "count",
            "status",
            "date",
            "text",
            "percentage",
            "currency",
            "location"
          ]
        },
        "area_type": {
          "oneOf": [
            {
              "$ref": "#/$defs/areaType"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_type": {
          "oneOf": [
            {
              "$ref": "#/$defs/priceType"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "oneOf": [
            {
              "$ref": "#/$defs/currency"
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator_area_type": {
          "oneOf": [
            {
              "$ref": "#/$defs/areaType"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "quality_status": {
          "$ref": "#/$defs/qualityStatus"
        },
        "benchmark_eligible": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "derivation": {
          "oneOf": [
            {
              "$ref": "#/$defs/derivation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_kind": {
                "const": "derived"
              }
            },
            "required": [
              "value_kind"
            ]
          },
          "then": {
            "properties": {
              "derivation": {
