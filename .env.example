# API
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info
SNAPSHOT_PATH=./data/generated/viva-platform-demo.json
SNAPSHOT_SCHEMA_PATH=./packages/contracts/schemas/demo-v2.schema.json
# SNAPSHOT_SHA256=sha256_esperado_opcional
CORS_ORIGIN=http://localhost:5173

# Actualización controlada. El API solo despacha el lote: no extrae datos en la petición pública.
DATA_REFRESH_ENABLED=false
DATA_REFRESH_OPERATOR_KEY=replace-with-an-operator-key
DATA_REFRESH_DISPATCH_URL=http://ops:3100
DATA_REFRESH_INTERNAL_TOKEN=replace-with-an-internal-token
DATA_REFRESH_EXECUTE=false
OPS_PORT=3100

# Web. En desarrollo Vite redirige /api al backend local.
VITE_API_BASE_URL=/api/v1

# Compose / publicación OCI
IMAGE_OWNER=stefano-mt
IMAGE_TAG=latest
